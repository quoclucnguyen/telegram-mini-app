    "@telegram-apps/telegram-ui": "^2.1.8",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "antd-mobile": "^5.39.0",
    "antd-mobile-icons": "^0.3.0",
    "dayjs": "^1.11.13",
    "pica": "^9.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "uuid": "^11.1.0",
    "zod": "^3.25.74",
    "zustand": "^5.0.6"
